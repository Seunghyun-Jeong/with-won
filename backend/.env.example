# Database connection. Keep real credentials in a local .env file or environment variables.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=withwon
DB_USERNAME=withwon
DB_PASSWORD=change-me

# Optional JDBC override. When set, this takes precedence over DB_HOST/DB_PORT/DB_NAME.
# WITHWON_DB_URL=jdbc:mysql://localhost:3306/withwon?sslMode=REQUIRED&connectionTimeZone=Asia/Seoul&characterEncoding=UTF-8
# WITHWON_DB_USERNAME=withwon
# WITHWON_DB_PASSWORD=change-me

WITHWON_JWT_SECRET=change-me-to-a-long-random-secret
