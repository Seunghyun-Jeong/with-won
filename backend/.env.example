# 이 파일을 같은 폴더에 .env로 복사해 값을 채운다. .env는 git에 올리지 않는다. 값에 따옴표를 붙이지 않는다.
# CLOVA OCR General(V2). 콘솔 CLOVA OCR > Domain > API Gateway 연동에서 받는다.
OCR_API_URL=
OCR_API_KEY=
# CLOVA Speech 장문 인식. 콘솔 CLOVA Speech > 도메인 > 빌더 실행 > 설정 > 연동 정보에서 받는다.
# SPEECH_API_URL은 Invoke URL 그대로(끝에 /recognizer/upload를 붙이지 않는다), SPEECH_API_KEY는 Secret Key.
SPEECH_API_URL=
SPEECH_API_KEY=
